# 이 파일을 secret.yaml로 복사 후 값 채우기. secret.yaml은 .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: meeting-notes
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "REPLACE_ME_ROOT"
  MYSQL_DATABASE: "meeting_notes"
  MYSQL_USER: "appuser"
  MYSQL_PASSWORD: "REPLACE_ME_USER"
